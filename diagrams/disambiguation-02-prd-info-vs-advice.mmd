  C -- "no" --> E["PRD-001 / PRD-002 / PRD-003 / PRD-004:<br/>Progressive Disclosure, 1-2 sentences first"]
  B -- "yes" --> F{"Personal circumstance cue?<br/>my salary, my age, my goal, mere paise"}
  F -- "yes" --> G["PRD-005 + do NOT collect income,<br/>age or portfolio details"]
  F -- "no" --> G
  G --> H["Reply = factual part + boundary sentence<br/>+ offer SEBI-registered advisor"]
  H --> I["ESC-013 offered P1 Wealth Advisory"]
